* {
    font-family: "Space Grotesk", "Inter", "Segoe UI Variable", "Segoe UI", -apple-system, system-ui, sans-serif;
}

QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #080d15, stop:0.4 #0a111a, stop:1 #06090e);
}

/* ── Sidebar ────────────────────────────────────────────────────────────── */
QWidget#Sidebar {
    background-color: #090e15;
    border-right: 1px solid rgba(255, 255, 255, 0.07);
}

/* ── Navigation Buttons ─────────────────────────────────────────────────── */
QPushButton#NavBtn {
    background-color: transparent;
    color: #94a3b8;
    border: none;
    padding: 10px 14px;
    text-align: left;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 500;
    margin: 2px 0px;
}
QPushButton#NavBtn:hover {
    background-color: rgba(56, 189, 248, 0.08);
    color: #e2e8f0;
}
QPushButton#NavBtn:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(56, 189, 248, 0.18), stop:1 rgba(56, 189, 248, 0.05));
    color: #38bdf8;
    font-weight: 600;
    border-left: 3px solid #38bdf8;
    padding-left: 11px;
}

/* ── General Buttons ────────────────────────────────────────────────────── */
QPushButton {
    background-color: transparent;
    color: #e2e8f0;
    border: none;
    padding: 10px 16px;
    text-align: left;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: rgba(56, 189, 248, 0.08);
    color: #38bdf8;
}

/* ── Logout Button ──────────────────────────────────────────────────────── */
QPushButton#LogoutBtn {
    background-color: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    text-align: center;
    font-weight: 600;
    border: 1px solid rgba(239, 68, 68, 0.2);
    border-radius: 8px;
    font-size: 12px;
    padding: 9px;
}
QPushButton#LogoutBtn:hover {
    background-color: rgba(239, 68, 68, 0.22);
    color: #f87171;
    border-color: rgba(239, 68, 68, 0.4);
}

/* ── Primary Action Button ──────────────────────────────────────────────── */
QPushButton#ActionBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0284c7, stop:1 #38bdf8);
    color: #020617;
    font-weight: 700;
    text-align: center;
    border-radius: 10px;
    font-size: 13px;
    padding: 10px 22px;
    border: none;
}
QPushButton#ActionBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #38bdf8, stop:1 #7dd3fc);
}
QPushButton#ActionBtn:disabled {
    background: rgba(30, 58, 95, 0.5);
    color: #64748b;
}

/* ── Danger Action Button ───────────────────────────────────────────────── */
QPushButton#DangerBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #e11d48, stop:1 #f43f5e);
    color: #ffffff;
    font-weight: 700;
    text-align: center;
    border-radius: 10px;
    border: 1px solid rgba(244, 63, 94, 0.3);
    font-size: 13px;
    padding: 10px 22px;
}
QPushButton#DangerBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #f43f5e, stop:1 #fb7185);
    border-color: rgba(244, 63, 94, 0.5);
}
QPushButton#DangerBtn:disabled {
    background: rgba(127, 29, 29, 0.25);
    color: #64748b;
    border-color: transparent;
}

/* ── Ghost Button (subtle outline) ──────────────────────────────────────── */
QPushButton#GhostBtn {
    background-color: rgba(56, 189, 248, 0.06);
    color: #38bdf8;
    font-weight: 600;
    text-align: center;
    border-radius: 10px;
    border: 1px solid rgba(56, 189, 248, 0.22);
    font-size: 13px;
    padding: 10px 20px;
}
QPushButton#GhostBtn:hover {
    background-color: rgba(56, 189, 248, 0.14);
    border-color: rgba(56, 189, 248, 0.4);
    color: #7dd3fc;
}

/* ── Input Fields ───────────────────────────────────────────────────────── */
QLineEdit {
    background-color: rgba(12, 20, 31, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #f8fafc;
    padding: 9px 14px;
    border-radius: 10px;
    font-size: 13px;
    selection-background-color: #0369a1;
}
QLineEdit:focus {
    border: 1px solid #38bdf8;
    background-color: rgba(16, 26, 40, 0.95);
}
QLineEdit::placeholder {
    color: #64748b;
}

/* ── Table Widget ───────────────────────────────────────────────────────── */
QTableWidget {
    background-color: #0f1824;
    color: #f8fafc;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    selection-background-color: rgba(56, 189, 248, 0.12);
    selection-color: #f8fafc;
    outline: none;
    font-size: 13px;
}
QTableWidget::item {
    padding: 8px 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}
QTableWidget::item:hover {
    background-color: rgba(56, 189, 248, 0.06);
}
QTableWidget::item:selected {
    background-color: rgba(56, 189, 248, 0.12);
    color: #f8fafc;
}
QTableWidget::item:focus {
    outline: none;
    border: none;
}

/* ── Table Checkbox Styling ─────────────────────────────────────────────── */
QTableWidget::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1px solid rgba(148, 163, 184, 0.4);
    background-color: rgba(12, 20, 31, 0.6);
}
QTableWidget::indicator:hover {
    border-color: #38bdf8;
    background-color: rgba(56, 189, 248, 0.1);
}
QTableWidget::indicator:checked {
    border-color: #38bdf8;
    background-color: #0284c7;
}

/* ── Table Header ───────────────────────────────────────────────────────── */
QHeaderView::section {
    background-color: #090e15;
    color: #94a3b8;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
}

/* ── Scrollbars ─────────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px;
}
QScrollBar::handle:vertical {
    background: rgba(148, 163, 184, 0.2);
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(148, 163, 184, 0.4);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 2px 4px;
}
QScrollBar::handle:horizontal {
    background: rgba(148, 163, 184, 0.2);
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: rgba(148, 163, 184, 0.4);
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Progress Bar ───────────────────────────────────────────────────────── */
QProgressBar {
    border: none;
    border-radius: 3px;
    text-align: center;
    color: transparent;
    background-color: rgba(30, 45, 61, 0.6);
    min-height: 6px;
    max-height: 6px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0284c7, stop:1 #38bdf8);
    border-radius: 3px;
}

/* ── Terminal / Logs ────────────────────────────────────────────────────── */
QTextEdit {
    background-color: #070b12;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    color: #f8fafc;
    font-family: "Cascadia Code", "Fira Code", "JetBrains Mono", Consolas, monospace;
    font-size: 12px;
    padding: 14px;
    selection-background-color: #0369a1;
}

/* ── Message Box ────────────────────────────────────────────────────────── */
QMessageBox {
    background-color: #101924;
}
QMessageBox QLabel {
    color: #f8fafc;
    font-size: 13px;
}
QMessageBox QPushButton {
    background-color: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.25);
    padding: 8px 24px;
    border-radius: 8px;
    text-align: center;
    color: #f8fafc;
    font-size: 13px;
    font-weight: 600;
}
QMessageBox QPushButton:hover {
    background-color: rgba(56, 189, 248, 0.2);
    border-color: #38bdf8;
}

/* ── Context Menu ───────────────────────────────────────────────────────── */
QMenu {
    background-color: #101924;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 6px;
}
QMenu::item {
    padding: 8px 24px 8px 12px;
    border-radius: 6px;
    color: #f8fafc;
    font-size: 13px;
}
QMenu::item:selected {
    background-color: rgba(56, 189, 248, 0.12);
    color: #38bdf8;
}
